# ViTrack 配置示例：复制到项目根目录并改名为 .env 后生效。
# 优先级：进程环境变量 > .env > app/config.py 中的默认值。
# 这是后续各阶段共享的参数清单，配置读取通过不代表所有功能已经实现。

# 服务地址与证书。8443 是手机 HTTPS 的计划端口，PC 调试地址将在服务阶段提供。
APP_HOST=0.0.0.0
APP_PORT=8443
HTTPS_CERT=certs/cert.pem
HTTPS_KEY=certs/key.pem
# ws 表示浏览器推帧；ipcam 表示电脑读取手机视频流。
SOURCE=ws
# 使用 ipcam 时填写手机实际显示的 http/https/rtsp 视频地址，不要照抄示例 IP。
IPCAM_URL=

# 检测模型路径以项目根目录为起点。
DET_MODEL=weights/yolo11n.pt
# 图像输入尺寸需为 32 的倍数；480 较省计算，640 较清晰，800 计算量更大。
DET_IMGSZ=640
# 0～1：提高置信度阈值会减少低把握的检测，也可能漏掉小目标。
DET_CONF=0.35
DET_IOU=0.5
# 0 表示第一张 GPU；cpu 表示改用 CPU，通常会变慢。
DET_DEVICE=0
# 0 为人物；多个 COCO 类别用逗号分隔，例如 0,2；留空表示全部 80 类。
TARGET_CLASSES=0

# 跟踪参数：丢失轨迹保留 30 帧；身份库保存时长与轨迹不是同一概念。
TRACKER=bytetrack.yaml
TRACK_MAX_AGE=30

# 以下供后续重识别阶段使用，初次运行先保留默认值。
REID_MODEL=mobilenet_v3_small
REID_EMA=0.9
# 高阈值用于确认相似，低阈值用于发现误绑；LOW 必须小于 HIGH。
REID_TAU_HIGH=0.65
REID_TAU_LOW=0.45
REID_MARGIN=0.05
REID_CONFIRM_FRAMES=3
REID_MAX_TEMPLATES=5
# 外观与颜色的权重之和必须为 1。
REID_W_APPEAR=0.85
REID_W_COLOR=0.15

# 传输与录制参数；调低质量或最长边能减小帧体积，但也会损失细节。
JPEG_QUALITY=0.65
MAX_SIDE=640
RECORD_FPS=15
