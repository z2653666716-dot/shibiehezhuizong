# ViTrack 配置示例：复制到项目根目录并改名为 .env 后生效。
# 优先级：进程环境变量 > .env > app/config.py 中的默认值。
# 通用启动读取本文件中的默认值；run.py会覆盖本次进程的身份模式、证书等参数。

# 通用启动的服务地址与证书；run.py默认使用8450端口和certs/hotspot。
APP_HOST=0.0.0.0
APP_PORT=8443
HTTPS_CERT=certs/cert.pem
HTTPS_KEY=certs/key.pem
# ws 表示浏览器推帧；ipcam 表示电脑读取手机视频流。
SOURCE=ws
# 使用 ipcam 时填写手机实际显示的 http/https/rtsp 视频地址；默认不读取，需明确确认启动。
# 页面会按模式显示确认控件；不要将本机数字摄像头编号写到这里。
IPCAM_URL=

# 检测模型路径以项目根目录为起点。
DET_MODEL=weights/yolo11n.pt
# 图像输入尺寸需为 32 的倍数；480 较省计算，640 较清晰，800 计算量更大。
DET_IMGSZ=640
# 0～1：提高置信度阈值会减少低把握的检测，也可能漏掉小目标。
DET_CONF=0.35
DET_IOU=0.5
# 0 表示第一张 GPU；cpu 表示改用 CPU，通常会变慢。
DET_DEVICE=0
# 0 为人物；多个 COCO 类别用逗号分隔，例如 0,2；留空表示全部 80 类。
TARGET_CLASSES=0

# 跟踪参数：丢失轨迹保留 30 帧；身份库保存时长与轨迹不是同一概念。
TRACKER=bytetrack.yaml
TRACK_MAX_AGE=30

# 身份后端。appearance为兼容模式，hybrid使用OSNet与人脸联合匹配。
REID_MODEL=mobilenet_v3_small
IDENTITY_MODE=appearance
IDENTITY_DEVICE=cpu
# hybrid可使用run.py或scripts/run_identity.ps1启动，需要先准备下列3份模型。
PERSON_WEIGHTS=weights/osnet_x0_25_msmt17.onnx
FACE_DETECTOR_WEIGHTS=weights/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_WEIGHTS=weights/face_recognition_sface_2021dec.onnx
FACE_MATCH_THRESHOLD=0.45
FACE_REJECT_THRESHOLD=0.10
BODY_MATCH_THRESHOLD=0.75
BODY_HOLD_THRESHOLD=0.55
IDENTITY_HOLD_SECONDS=2
REID_WEIGHTS=weights/mobilenet_v3_small-047dcff4.pth
# 只有足量真实标注配对标定并应用门槛后才设为true；公开增强诊断不算。
REID_CALIBRATED=false
# 身份只在当前视频会话的内存中保留；达到上限后需删除不用的身份。
IDENTITY_LIMIT=20
REID_EMA=0.9
# 高阈值用于确认相似，低阈值用于发现误绑；LOW 必须小于 HIGH。
# appearance模式的高阈值；提高可能减少误认但增加漏匹配，需要数据集标定。
REID_TAU_HIGH=0.90
REID_TAU_LOW=0.45
REID_MARGIN=0.05
REID_CONFIRM_FRAMES=6
# 神经网络外观融合模式也单独检查颜色，避免单一分量掩盖明显不同的衣着。
REID_COLOR_MIN=0.60
REID_MAX_TEMPLATES=5
# 外观与颜色的权重之和必须为 1。
REID_W_APPEAR=0.85
REID_W_COLOR=0.15

# 传输与录制参数；调低质量或最长边能减小帧体积，但也会损失细节。
JPEG_QUALITY=0.65
MAX_SIDE=640
RECORD_FPS=15
# 默认禁止媒体落盘。即使实现录制，仍须另行明确授权后才可改为 true。
ALLOW_MEDIA_SAVE=false
